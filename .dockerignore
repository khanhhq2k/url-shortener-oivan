# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.
# Fly.io: keep the root Dockerfile in the build context (do not add `/Dockerfile` here).

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore CI service files.
/.github

# Ignore Kamal files.
/config/deploy*.yml
/.kamal

# Ignore development files
/.devcontainer

# Local bundle (wrong platform gems on macOS); image runs `bundle install` in the build stage.
/vendor/bundle

# Dev-only Dockerfile — keep root `Dockerfile` in the context (Fly remote builds need it in the tarball).
/Dockerfile.dev
